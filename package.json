{
  "name": "fit-count-app",
  "id": "uk.ac.ceh.fit",
  "title": "FIT Count",
  "version": "1.7.0",
  "scripts": {
    "prepare": "husky",
    "start": "webpack serve --progress --port 8000",
    "build": "NODE_ENV=production webpack",
    "build:production": "npm run clean && npm run build && npx cap sync && npm run build:resources",
    "build:resources": "mkdir -p resources && cp -R other/designs/android resources && cp -R other/designs/*.png resources && npx cordova-res ios --skip-config --resources resources --copy && npx cordova-res android --skip-config --resources resources --copy",
    "deploy": "cp other/demo.html build/ && URL=$(vercel --prod -t $VERCEL_TOKEN --yes -A ./other/vercel.json ./build) && CLEAN_URL=$(echo $URL | sed -r \"s/https:\\/\\/(.*)$/\\1/g\") && DEMO_URL=$(echo $CLEAN_URL | sed -r \"s/(.*\\-)[a-z0-9]+\\-flumens(\\.vercel\\.app)$/\\1${BITRISE_BUILD_NUMBER}\\2/g\") && envman add --key DEMO_URL --value \"https://$DEMO_URL\"",
    "deploy:production": "bitrise run ci",
    "check": "npx tsc --noEmit --skipLibCheck && npm run test:eslint",
    "clean": "rm -rf build resources",
    "test": "jest --silent --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand --watch test",
    "test:eslint": "eslint src --quiet && echo '\\033[37;42;1m PASS \\033[00m'",
    "fetch:data": "cd src/common/data && node make.js"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@flumens/bigu": "^0.4.1",
    "@flumens/ionic": "2.0.0-alpha.86",
    "@flumens/models": "0.17.2",
    "@flumens/tailwind": "0.38.1",
    "@flumens/utils": "^0.7.0",
    "@hookform/resolvers": "5.2.2",
    "@ionic-native/core": "5.36.0",
    "@ionic/core": "^8.7.17",
    "@ionic/react": "^8.7.17",
    "@ionic/react-router": "^8.7.17",
    "@sentry/browser": "10.38.0",
    "@sentry/integrations": "7.114.0",
    "axios": "^1.13.4",
    "capacitor-blob-writer": "1.1.20",
    "clsx": "^2.1.1",
    "deep-diff": "^1.0.2",
    "drizzle-orm": "0.45.1",
    "i18next": "^25.8.0",
    "ionicons": "8.0.13",
    "jeep-sqlite": "2.8.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.23",
    "mapbox-gl": "3.18.1",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "mobx-utils": "^6.1.1",
    "mock-geolocation": "1.0.11",
    "react": "^19.2.4",
    "react-autosuggest": "10.1.0",
    "react-countdown-now": "^2.1.2",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.4",
    "react-map-gl": "^8.1.0",
    "react-router": "^5.2.0",
    "react-router-dom": "^5.2.0",
    "sql.js": "1.12.0",
    "swiper": "^12.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-exponentiation-operator": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@capacitor/cli": "^8.0.2",
    "@flumens/eslint-config": "^3.0.1",
    "@flumens/fetch-onedrive-excel": "^0.3.4",
    "@flumens/prettier-config": "^0.4.0",
    "@flumens/webpack-config": "^6.0.3",
    "@types/jest": "^30.0.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "babel-jest": "^30.2.0",
    "babel-plugin-module-resolver": "5.0.2",
    "copy-webpack-plugin": "^13.0.1",
    "cordova-res": "^0.15.4",
    "dotenv": "^17.2.3",
    "eslint": "9.39.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-transform-stub": "2.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vercel": "^50.9.5",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "browserslist": [
    "ChromeAndroid >=89",
    "iOS >=12"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "author": {
    "name": "Flumens",
    "email": "enquiries@flumens.io",
    "url": "https://flumens.io"
  },
  "babel": {
    "presets": [
      [
        "@babel/react",
        {
          "runtime": "automatic"
        }
      ],
      [
        "@babel/env",
        {
          "loose": true,
          "modules": "commonjs",
          "corejs": "3.22",
          "useBuiltIns": "usage"
        }
      ],
      [
        "@babel/typescript",
        {
          "allowDeclareFields": true
        }
      ]
    ],
    "plugins": [
      [
        "@babel/transform-runtime",
        {
          "regenerator": true
        }
      ],
      [
        "module-resolver",
        {
          "root": [
            "./src"
          ],
          "alias": {
            "@flumens$": "./src/common/flumens",
            "common": "./src/common",
            "helpers": "./src/common/helpers",
            "models": "./src/common/models",
            "Components": "./src/common/Components"
          }
        }
      ],
      [
        "@babel/proposal-private-property-in-object",
        {
          "loose": true
        }
      ],
      "@babel/transform-exponentiation-operator",
      "@babel/syntax-dynamic-import"
    ]
  },
  "prettier": "@flumens/prettier-config",
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "babel-jest",
        {
          "presets": [
            "@babel/env"
          ]
        }
      ]
    },
    "testRegex": "src.*((\\.|/*.)(spec))\\.(t|j)s?$",
    "moduleNameMapper": {
      "^.+.(css|style|less|sass|scss|svg|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "ionic-native": "jest-transform-stub",
      "swiper": "jest-transform-stub"
    },
    "moduleDirectories": [
      "node_modules",
      "components",
      "src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!@ionic|@stencil|ionicons)"
    ]
  }
}
